# Configuration for later milestones. No secrets belong in Git.
APP_ENV=development
LOG_LEVEL=INFO
RAW_DATA_DIR=data/raw
REJECTED_DATA_DIR=data/rejected
POSTGRES_DB=zmg_cafes
POSTGRES_USER=zmg_cafes
POSTGRES_PASSWORD=zmg_cafes_dev
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=8080
DATABASE_URL=postgresql+psycopg://zmg_cafes:zmg_cafes_dev@localhost:5432/zmg_cafes
API_HOST=127.0.0.1
API_PORT=8000
# Required for --live --source inegi_denue; request a token at
# https://www.inegi.org.mx/app/api/denue/. Never commit the real value.
INEGI_DENUE_TOKEN=
# ZMG_TEST_DATABASE_URL (tests/integration/) must NEVER equal DATABASE_URL
# above: test_load_postgis.py/test_api_postgis.py TRUNCATE on every test.
# Use the disposable `test-db` compose service (profile "test"), see
# docs/database.md. Issue #59 lost real data by pointing this at the dev db.
